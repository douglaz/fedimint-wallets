# Upstream wallet clones analyzed in this repo — NOT vendored here.
# These are other projects' repos (each has its own .git + remote).
# Clone them yourself; sources are listed in the README and the report.
/ecash-app/
/harbor/
/vipr-wallet/

# Local scratch
*.tmp
.DS_Store

# Rust build output
/target
# Opt-in target dir for the live devimint smokes: exact runbook/header recipes reset this
# directory before each build, enter Nix through a fixed child-environment allowlist, use a fresh
# temporary Cargo source home (so mutable Git checkouts are not reused), and pass Cargo
# `--target-dir <repo>/target-nix`; the scripts look for
# target-nix/{debug,release}/wallet-cli. Ordinary local `nix develop` commands may still use
# /target above and are not certifying live-validation recipes.
/target-nix
# review/build output
/target-review
# stray build artifacts sometimes emitted at the repo root
/test
/move_index
# wallet-cli local data dir (RocksDB + mnemonic) when run by hand
/.wallet-cli-data/
.rb-lite/
# isolated target dir for dependency-bump validation (keeps target-nix binaries
# untouched while a soak/smoke runs from them)
/target-pinbump
target-musl/
# Anchored: a slash-less pattern matches at EVERY level, so a future `docs/result-analysis.md`
# or `wallet-core/result-types/` would be silently invisible to `git status`. These are the
# root-level `nix build` output links only.
/result
# Any named `nix build -o` link, e.g. result-image, and the per-package links CI builds
# (result-walletd, result-wallet-cli) which anyone reproducing that job locally also gets.
/result-*

# bv (beads viewer) local config and caches
.bv/

# stray build artifacts committed by accident alongside 5016a04, then purged by a history
# rewrite (so they no longer appear at that commit); ignored so `add -A` cannot reintroduce them
await_temp
match_field
match_field2
