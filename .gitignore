# Upstream wallet clones analyzed in this repo — NOT vendored here.
# These are other projects' repos (each has its own .git + remote).
# Clone them yourself; sources are listed in the README and the report.
/ecash-app/
/harbor/
/vipr-wallet/

# Local scratch
*.tmp
.DS_Store

# Rust build output
/target
# Opt-in target dir for the live devimint smokes: their documented invocation passes
# CARGO_BUILD_TARGET_DIR=<repo>/target-nix explicitly, and the scripts look for
# target-nix/{debug,release}/wallet-cli. `nix develop` does NOT set CARGO_TARGET_DIR — a
# plain cargo build in the devshell writes to /target above. The earlier wording here said
# otherwise and led a reviewer to conclude CI was caching the wrong directory.
/target-nix
# review/build output
/target-review
# stray build artifacts sometimes emitted at the repo root
/test
/move_index
# wallet-cli local data dir (RocksDB + mnemonic) when run by hand
/.wallet-cli-data/
.rb-lite/
# isolated target dir for dependency-bump validation (keeps target-nix binaries
# untouched while a soak/smoke runs from them)
/target-pinbump
target-musl/
result
# Any named `nix build -o` link, e.g. result-image, and the per-package links CI builds
# (result-walletd, result-wallet-cli) which anyone reproducing that job locally also gets.
result-*

# bv (beads viewer) local config and caches
.bv/

# stray build artifacts committed by accident alongside 5016a04, then purged by a history
# rewrite (so they no longer appear at that commit); ignored so `add -A` cannot reintroduce them
await_temp
match_field
match_field2
